  {
    "id": "b7e2d9a1-4c58-4f37-8a26-9d5b1e7c3f02",
    "scriptName": "开局（艾瑟兰战役·毛坯版）",
    "findRegex": "<艾瑟兰开局/>",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>艾瑟兰战役 · 开局</title>\n<style>\n  /* 毛坯版：只做信息结构与可读性，不做美术。样式限定在 #aiselan-opening 内。 */\n  #aiselan-opening{--line:#3a4352;--ink:#d6dce6;--dim:#8a94a6;--card:#1b2029;--bg:#12161d;--ok:#8fd694;--warn:#e8c76a;--bad:#e88a8a;\n    background:var(--bg);color:var(--ink);font:14px/1.7 \"Microsoft YaHei\",system-ui,sans-serif;\n    padding:12px;border-radius:8px;max-width:720px;margin:8px auto;border:1px solid var(--line);}\n  #aiselan-opening *{box-sizing:border-box;}\n  #aiselan-opening h3{margin:0 0 4px;font-size:15px;color:#9ecbff;letter-spacing:1px;}\n  #aiselan-opening .sub{font-size:12px;color:var(--dim);}\n  #aiselan-opening .sec{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:9px 11px;margin-bottom:9px;}\n  #aiselan-opening .sec h4{margin:0 0 6px;font-size:13px;color:#9ecbff;font-weight:600;border-bottom:1px dashed var(--line);padding-bottom:4px;}\n  #aiselan-opening textarea{width:100%;min-height:88px;background:#0c0f14;border:1px solid var(--line);color:var(--ink);\n    border-radius:6px;padding:8px;font:13px/1.7 inherit;resize:vertical;}\n  #aiselan-opening .gbtn{border:1px solid var(--line);background:#151a22;color:var(--dim);border-radius:6px;\n    padding:6px 22px;font-size:14px;cursor:pointer;margin-right:8px;}\n  #aiselan-opening .gbtn.on{border-color:#9ecbff;color:#9ecbff;background:#101a24;font-weight:600;}\n  #aiselan-opening .arow{display:flex;align-items:center;gap:8px;margin:5px 0;}\n  #aiselan-opening .arow .nm{width:44px;color:var(--dim);font-size:13px;}\n  #aiselan-opening .stp{width:28px;height:28px;border:1px solid var(--line);background:#151a22;color:var(--ink);\n    border-radius:5px;font-size:16px;line-height:1;cursor:pointer;}\n  #aiselan-opening .stp:disabled{opacity:.35;cursor:not-allowed;}\n  #aiselan-opening .aval{width:44px;text-align:center;font-size:16px;font-weight:700;}\n  #aiselan-opening .hint{font-size:12px;color:var(--dim);margin-left:6px;}\n  #aiselan-opening .remain{font-size:13px;margin-bottom:4px;}\n  #aiselan-opening .remain b{font-size:16px;}\n  #aiselan-opening .start{width:100%;padding:10px;border-radius:6px;border:1px solid var(--ok);background:#14201a;\n    color:var(--ok);font-size:15px;font-weight:600;cursor:pointer;}\n  #aiselan-opening .start:disabled{border-color:var(--line);background:#151a22;color:#5a6478;cursor:not-allowed;}\n  #aiselan-opening #ae-o-msg{font-size:12px;margin-top:8px;min-height:18px;}\n  #aiselan-opening .warnbar{border:1px solid var(--warn);color:var(--warn);border-radius:6px;padding:6px 10px;font-size:12px;margin-bottom:9px;}\n  #aiselan-opening .done{border-color:var(--ok);color:var(--ok);}\n</style>\n</head>\n<body>\n<div id=\"aiselan-opening\">（艾瑟兰开局：尚未加载）</div>\n<script>\n(function () {\n  'use strict';\n  /* 默认存档模板由 build.mjs 从 core/schema.ts 的「开局存档」注入（单一事实来源） */\n  var 默认存档 = {\"version\":1,\"时刻\":{\"当前时刻\":\"1042年11月29日 14:20\",\"累计分钟\":0},\"位置\":{\"当前\":\"审判广场\",\"区域\":\"下层\"},\"时钟\":{\"维尔伦陷落度\":0,\"教会肃清进度\":0},\"算力\":{\"当前算力\":0,\"速率\":10,\"累计消耗\":0,\"推演记录\":[]},\"物品\":[],\"主角\":{\"性别\":\"男\",\"属性\":{\"力量\":8,\"敏捷\":8,\"体质\":8,\"智力\":11},\"临时加成\":[],\"状态\":\"\",\"技能\":[],\"装备\":{\"武器\":null,\"副手\":null,\"护甲\":null,\"饰品\":null},\"精练师等级\":\"无\",\"已解锁知识库\":[\"地球\"]},\"生物\":{\"爱丽丝\":{\"类型\":\"核心\",\"立场\":\"同伴\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":8,\"敏捷\":11,\"体质\":10,\"智力\":15},\"临时加成\":[],\"技能\":[],\"装备\":{\"武器\":null,\"副手\":null,\"护甲\":null,\"饰品\":null}},\"诺拉\":{\"类型\":\"重要\",\"立场\":\"同伴\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":6,\"敏捷\":11,\"体质\":8,\"智力\":13},\"临时加成\":[],\"技能\":[]},\"瓦尔特\":{\"类型\":\"重要\",\"立场\":\"同伴\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":12,\"敏捷\":7,\"体质\":11,\"智力\":10},\"临时加成\":[],\"技能\":[]},\"提尔雅\":{\"类型\":\"重要\",\"立场\":\"同伴\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":7,\"敏捷\":12,\"体质\":8,\"智力\":9},\"临时加成\":[],\"技能\":[]},\"维克托\":{\"类型\":\"重要\",\"立场\":\"敌对\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":12,\"敏捷\":11,\"体质\":12,\"智力\":14},\"临时加成\":[],\"技能\":[]},\"马利基\":{\"类型\":\"重要\",\"立场\":\"敌对\",\"已遇见\":false,\"状态\":\"\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":14,\"敏捷\":12,\"体质\":14,\"智力\":16},\"临时加成\":[],\"技能\":[]},\"虚空暴食魔\":{\"类型\":\"生物\",\"立场\":\"敌对\",\"已遇见\":false,\"状态\":\"关押于教会地下室\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":15,\"敏捷\":7,\"体质\":16,\"智力\":4},\"临时加成\":[],\"技能\":[]},\"异界幼体\":{\"类型\":\"生物\",\"立场\":\"敌对\",\"已遇见\":false,\"状态\":\"未降临\",\"和主角的关系\":\"路人\",\"属性\":{\"力量\":17,\"敏捷\":15,\"体质\":17,\"智力\":12},\"临时加成\":[],\"技能\":[]}}};\n  var 总点数 = 40;\n  var 属性名 = ['力量', '敏捷', '体质', '智力'];\n  var 单项上限 = 13;   // 本卷天花板\n  var 单项下限 = 1;\n  var 开场白占位 = '火把落下。火焰没有吞噬那个女孩，而是化成了柔和厚重的暗金色。第三排的神甫手里的圣经掉在了地上。台上的执行官维克托脸色惨白，猛地拔出腰间佩剑。同一秒，脚下的广场发出巨兽撕裂般的巨响——中央塌陷了，黑色浓烟喷涌而出。';\n\n  var el = document.getElementById('aiselan-opening');\n  if (!el) return;\n\n  /* ── 状态 ── */\n  var S = { 男: '男', 性别: null, 属性: { 力量: 10, 敏捷: 10, 体质: 10, 智力: 10 } };\n  var 已开局 = false;\n  try {\n    var chat = (typeof getVariables === 'function') ? getVariables({ type: 'chat' }) : null;\n    已开局 = !!(chat && chat['艾瑟兰']);\n  } catch (e) {}\n\n  function 用了() { var s = 0; 属性名.forEach(function (n) { s += S.属性[n]; }); return s; }\n  function 剩余() { return 总点数 - 用了(); }\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"]/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c];\n    });\n  }\n\n  function 渲染() {\n    var 剩 = 剩余();\n    el.innerHTML = ''\n      + '<h3>艾瑟兰战役 · 开局</h3>'\n      + '<div class=\"sub\">第一卷 · 维尔伦沦陷沙盘 ｜ 余烬节 · 审判广场</div>'\n      + (已开局 ? '<div class=\"warnbar\">检测到已有存档：确认开局会覆盖当前进度。</div>' : '')\n      + '<div class=\"sec\"><h4>开场白（写入第 0 楼）</h4>'\n      + '<textarea id=\"ae-o-text\">' + esc(开场白占位) + '</textarea>'\n      + '<div class=\"sub\" style=\"margin-top:4px\">占位文本，之后替换为正式开场；玩家可自行编辑后再确认。</div></div>'\n      + '<div class=\"sec\"><h4>性别</h4>'\n      + '<button class=\"gbtn' + (S.性别 === '男' ? ' on' : '') + '\" data-gender=\"男\">男</button>'\n      + '<button class=\"gbtn' + (S.性别 === '女' ? ' on' : '') + '\" data-gender=\"女\">女</button>'\n      + '<span class=\"sub\" style=\"margin-left:8px\">纯叙事选项，第一卷无数值影响</span></div>'\n      + '<div class=\"sec\"><h4>四维属性（共 ' + 总点数 + ' 点，单项 ' + 单项下限 + '–' + 单项上限 + '）</h4>'\n      + '<div class=\"remain\">剩余点数 <b id=\"ae-o-remain\" style=\"color:' + (剩 === 0 ? 'var(--ok)' : 剩 < 0 ? 'var(--bad)' : 'var(--warn)') + '\">' + 剩 + '</b>'\n      + '　<span class=\"sub\">建议：力敏体 8–9、智 10–12；本卷天花板 13</span></div>'\n      + 属性名.map(function (n) {\n          return '<div class=\"arow\"><span class=\"nm\">' + n + '</span>'\n            + '<button class=\"stp\" data-dec=\"' + n + '\"' + (S.属性[n] <= 单项下限 ? ' disabled' : '') + '>−</button>'\n            + '<span class=\"aval\">' + S.属性[n] + '</span>'\n            + '<button class=\"stp\" data-inc=\"' + n + '\"' + (S.属性[n] >= 单项上限 || 剩 <= 0 ? ' disabled' : '') + '>＋</button>'\n            + '<span class=\"hint\">' + 属性说明(n, S.属性[n]) + '</span></div>';\n        }).join('')\n      + '</div>'\n      + '<button class=\"start\" id=\"ae-o-start\"' + (剩余() === 0 && S.性别 ? '' : ' disabled') + '>确认开局</button>'\n      + '<div id=\"ae-o-msg\"></div>';\n    绑定();\n  }\n\n  /* 世界标尺提示（《艾瑟兰设定集》四维标尺） */\n  function 属性说明(名, 值) {\n    var 标 = {\n      力量: [[5, '严重缺陷'], [8, '普通基准'], [13, '普通人极限'], [16, '怪物领域'], [20, '半神']],\n      敏捷: [[5, '严重缺陷'], [8, '普通基准'], [13, '普通人极限'], [16, '怪物领域'], [20, '半神']],\n      体质: [[5, '严重缺陷'], [8, '普通基准'], [13, '普通人极限'], [16, '怪物领域'], [20, '半神']],\n      智力: [[5, '无法施法'], [8, '普通基准'], [13, '普通人极限'], [16, '怪物领域'], [20, '半神']],\n    }[名];\n    var 名2 = '';\n    for (var i = 0; i < 标.length; i++) if (值 >= 标[i][0]) 名2 = 标[i][1];\n    return 名2;\n  }\n\n  function 绑定() {\n    el.querySelectorAll('[data-gender]').forEach(function (b) {\n      b.addEventListener('click', function () { S.性别 = b.getAttribute('data-gender'); 渲染(); });\n    });\n    el.querySelectorAll('[data-inc]').forEach(function (b) {\n      b.addEventListener('click', function () {\n        var n = b.getAttribute('data-inc');\n        if (剩余() > 0 && S.属性[n] < 单项上限) { S.属性[n]++; 渲染(); }\n      });\n    });\n    el.querySelectorAll('[data-dec]').forEach(function (b) {\n      b.addEventListener('click', function () {\n        var n = b.getAttribute('data-dec');\n        if (S.属性[n] > 单项下限) { S.属性[n]--; 渲染(); }\n      });\n    });\n    var st = el.querySelector('#ae-o-start');\n    if (st) st.addEventListener('click', 确认开局);\n  }\n\n  function 报(文字, 色) {\n    var m = el.querySelector('#ae-o-msg');\n    if (m) { m.textContent = 文字; m.style.color = 色 || 'var(--dim)'; }\n    try { if (色 === 'var(--bad)') toastr && toastr.error && toastr.error(文字); else toastr && toastr.success && toastr.success(文字); } catch (e) {}\n  }\n\n  /* ═══════════ 确认开局：写存档 + 开场白落 0 楼 + 快照 ═══════════ */\n  function 确认开局() {\n    if (剩余() !== 0) { 报('还有 ' + 剩余() + ' 点未分配', 'var(--bad)'); return; }\n    if (!S.性别) { 报('请选择性别', 'var(--bad)'); return; }\n    if (typeof updateVariablesWith !== 'function') { 报('需要酒馆助手环境（请在酒馆楼层内打开）', 'var(--bad)'); return; }\n\n    var 文本 = (el.querySelector('#ae-o-text') || {}).value || 开场白占位;\n    var g = JSON.parse(JSON.stringify(默认存档));\n    g.主角.性别 = S.性别;\n    g.主角.属性 = { 力量: S.属性.力量, 敏捷: S.属性.敏捷, 体质: S.属性.体质, 智力: S.属性.智力 };\n\n    var btn = el.querySelector('#ae-o-start');\n    if (btn) btn.disabled = true;\n    报('正在写入…');\n\n    /* ① 写 chat 变量存档 */\n    Promise.resolve(updateVariablesWith(function (v) { v['艾瑟兰'] = g; return v; }, { type: 'chat' }))\n      /* ② 开场白写入第 0 楼（若接口可用） */\n      .then(function () {\n        try {\n          if (typeof setChatMessages === 'function') {\n            return Promise.resolve(setChatMessages([{ message_id: 0, message: 文本 }], { refresh: 'all' })).catch(function () {});\n          }\n        } catch (e) {}\n      })\n      /* ③ 快照同步（剥 累计分钟）到第 0 楼与最新楼 */\n      .then(function () {\n        var snap = JSON.parse(JSON.stringify(g));\n        if (snap['时刻']) delete snap['时刻']['累计分钟'];\n        var ids = [0];\n        try { var last = (typeof getLastMessageId === 'function') ? getLastMessageId() : -1; if (last > 0) ids.push(last); } catch (e) {}\n        return ids.reduce(function (p, id) {\n          return p.then(function () {\n            return Promise.resolve(updateVariablesWith(function (v) {\n              v.stat_data = v.stat_data || {}; v.stat_data['艾瑟兰'] = snap; return v;\n            }, { type: 'message', message_id: id })).catch(function () {});\n          });\n        }, Promise.resolve());\n      })\n      .then(function () {\n        已开局 = true;\n        el.innerHTML = '<h3>艾瑟兰战役 · 开局</h3>'\n          + '<div class=\"sec done\"><h4>✓ 开局完成</h4>'\n          + '<div class=\"sub\">性别：' + esc(S.性别) + '　属性：力' + S.属性.力量 + ' 敏' + S.属性.敏捷 + ' 体' + S.属性.体质 + ' 智' + S.属性.智力 + '<br>'\n          + '存档已写入 chat 变量 <code>艾瑟兰</code>，开场白已写入第 0 楼，快照已同步。</div></div>'\n          + '<div class=\"sub\">下一步：直接开始对话，数据AI 会从正文提取状态变化。</div>';\n        try { toastr && toastr.success && toastr.success('开局完成'); } catch (e) {}\n      })\n      .catch(function (e) {\n        报('写入失败：' + e, 'var(--bad)');\n        if (btn) btn.disabled = false;\n      });\n  }\n\n  if (!默认存档) {\n    el.innerHTML = '（艾瑟兰开局：模板缺失 —— 请先 node build.mjs 重新产出本页）';\n    return;\n  }\n  if (typeof getVariables !== 'function') {\n    el.innerHTML = '<div class=\"warnbar\">未检测到酒馆助手环境：本页在酒馆楼层内由正则注入时可正常使用；当前为本地预览。</div>';\n  }\n  渲染();\n})();\n</script>\n</body>\n</html>\n",
    "trimStrings": [],
    "placement": [
      2
    ],
    "disabled": false,
    "markdownOnly": true,
    "promptOnly": false,
    "runOnEdit": true,
    "substituteRegex": 0,
    "minDepth": 0,
    "maxDepth": 0
  }
