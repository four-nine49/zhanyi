[
  {
    "id": "a3f1c2d4-7b6e-4a90-9c15-2e8f0b4d6a71",
    "scriptName": "状态栏（艾瑟兰战役·毛坯版）",
    "findRegex": "<StatusPlaceHolderImpl/>",
    "replaceString": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>艾瑟兰战役 · 状态栏（毛坯版）</title>\n<style>\n  /* 毛坯版：只做信息结构与可读性，不做美术。全部样式限定在 #aiselan-bar 内，不碰 body/视口。 */\n  #aiselan-bar{--line:#3a4352;--ink:#d6dce6;--dim:#8a94a6;--card:#1b2029;--bg:#12161d;\n    background:var(--bg);color:var(--ink);font:14px/1.65 \"Microsoft YaHei\",system-ui,sans-serif;\n    padding:10px;border-radius:8px;max-width:720px;margin:8px auto;border:1px solid var(--line);}\n  #aiselan-bar *{box-sizing:border-box;}\n  #aiselan-bar .card{background:var(--card);border:1px solid var(--line);border-radius:6px;padding:8px 10px;margin-bottom:8px;}\n  #aiselan-bar h4{margin:0 0 6px;font-size:13px;color:#9ecbff;letter-spacing:1px;font-weight:600;\n    border-bottom:1px dashed var(--line);padding-bottom:4px;}\n  #aiselan-bar .row{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;font-size:13px;}\n  #aiselan-bar .kv{color:var(--dim);} #aiselan-bar .kv b{color:var(--ink);font-weight:600;}\n  #aiselan-bar .muted{color:var(--dim);}\n  #aiselan-bar .badge{border:1px solid var(--line);border-radius:9px;padding:1px 9px;font-size:12px;color:var(--dim);}\n  #aiselan-bar .badge.ok{color:#8fd694;border-color:#8fd694;}\n  #aiselan-bar .badge.warn{color:#e8c76a;border-color:#e8c76a;}\n  #aiselan-bar .badge.bad{color:#e88a8a;border-color:#e88a8a;}\n  #aiselan-bar .bar{height:9px;background:#0c0f14;border:1px solid var(--line);border-radius:5px;overflow:hidden;margin:3px 0;position:relative;}\n  #aiselan-bar .bar i{display:block;height:100%;}\n  #aiselan-bar .bar .tick{position:absolute;top:-1px;bottom:-1px;width:1px;background:#5a6478;}\n  #aiselan-bar .grid2{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;}\n  #aiselan-bar .unit{border:1px solid var(--line);border-radius:5px;padding:6px 8px;font-size:12px;}\n  #aiselan-bar .unit .nm{font-weight:600;font-size:13px;}\n  #aiselan-bar .unit.dead{opacity:.45;}\n  #aiselan-bar .tag{display:inline-block;border:1px solid var(--line);border-radius:4px;padding:0 5px;margin:0 2px 2px 0;font-size:11px;color:var(--dim);}\n  #aiselan-bar .clocks{display:flex;gap:4px;align-items:center;}\n  #aiselan-bar .cell{width:16px;height:16px;border:1px solid var(--line);border-radius:3px;display:inline-block;background:#0c0f14;}\n  #aiselan-bar .cell.on{background:#e06c75;border-color:#e06c75;}\n  #aiselan-bar .cell.on.s2{background:#e5c07b;border-color:#e5c07b;}\n  #aiselan-bar .sub{font-size:11px;color:var(--dim);}\n</style>\n</head>\n<body>\n<div id=\"aiselan-bar\">（艾瑟兰状态栏：未读取到存档）</div>\n<script>\n(function () {\n  'use strict';\n  /* ── 常量表（与引擎口径一致，纯展示） ── */\n  var NS = '艾瑟兰';\n  var 阶段名 = ['风暴眼', '混乱期', '混乱期', '沦陷期·水源带毒', '沦陷期·焚城', '收束期·幼体降临', '终局·火炮洗地'];\n  var 肃清名 = ['追查中', '锁定玩家', '围捕', '全域神圣轰炸'];\n  var 属性名 = ['力量', '敏捷', '体质', '智力'];\n\n  function esc(s) {\n    return String(s == null ? '' : s).replace(/[&<>\"]/g, function (c) {\n      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c];\n    });\n  }\n\n  /* ── 数据读取：快照三层回退（当前楼 → -1 → -2 → -3），再回退 chat 变量（只读，不写） ── */\n  function readSnapshot() {\n    try {\n      var ids = [];\n      try { ids.push(getCurrentMessageId()); } catch (e) {}\n      ids.push(-1, -2, -3);\n      for (var i = 0; i < ids.length; i++) {\n        var v = getVariables({ type: 'message', message_id: ids[i] });\n        var s = v && v.stat_data && v.stat_data[NS];\n        if (s) return s;\n      }\n    } catch (e) {}\n    return null;\n  }\n  function readChat() {\n    try { var v = getVariables({ type: 'chat' }); return v ? v[NS] || null : null; } catch (e) { return null; }\n  }\n\n  /* ── 派生（与引擎口径一致） ── */\n  function 算力上限(g) { return 20 * ((g.主角 && g.主角.属性 && g.主角.属性.智力) || 0); }\n  function 世界状态(g) {\n    var c = (g.算力 && g.算力.累计消耗) || 0;\n    return c >= 250 ? '裂隙' : c >= 100 ? '异象' : '微澜';\n  }\n  function 生效(g, 名, 对象) {\n    var 基 = (对象.属性 && 对象.属性[名]) || 0;\n    var 加 = (对象.临时加成 || []).filter(function (b) { return b.属性 === 名; })\n      .reduce(function (s, b) { return s + (b.值 || 0); }, 0);\n    return { 基: 基, 生: 基 + 加, 加: 加 };\n  }\n  function 属性文本(g, 对象, 名) {\n    var r = 生效(g, 名, 对象);\n    return r.加 !== 0 ? (r.基 + '(' + (r.加 > 0 ? '+' : '') + r.加 + ')') : String(r.基);\n  }\n\n  function 时钟格(格数, 上限, cls) {\n    var s = '';\n    for (var i = 0; i < 上限; i++) s += '<span class=\"cell' + (i < 格数 ? ' on ' + (cls || '') : '') + '\"></span>';\n    return s;\n  }\n  function 进度条(值, 上限, 色, 刻度列表) {\n    var p = 上限 > 0 ? Math.min(100, Math.round(值 / 上限 * 100)) : 0;\n    var ticks = (刻度列表 || []).map(function (t) {\n      return '<span class=\"tick\" style=\"left:' + Math.min(100, Math.round(t / 上限 * 100)) + '%\"></span>';\n    }).join('');\n    return '<div class=\"bar\">' + ticks + '<i style=\"width:' + p + '%;background:' + 色 + '\"></i></div>';\n  }\n\n  /* ── 渲染 ── */\n  function 渲染(g) {\n    var h = [];\n    var 世界 = 世界状态(g);\n    var 世界cls = 世界 === '裂隙' ? 'bad' : 世界 === '异象' ? 'warn' : 'ok';\n\n    /* 顶栏：时刻 / 位置 / 世界状态 */\n    h.push('<div class=\"card\"><div class=\"row\">'\n      + '<span class=\"kv\">时刻 <b>' + esc(g.时刻 && g.时刻.当前时刻) + '</b></span>'\n      + '<span class=\"kv\">位置 <b>' + esc(g.位置 && (g.位置.区域 + ' · ' + g.位置.当前)) + '</b></span>'\n      + '<span class=\"badge ' + 世界cls + '\">' + 世界 + '</span>'\n      + '</div></div>');\n\n    /* 时钟 */\n    var 陷 = (g.时钟 && g.时钟.维尔伦陷落度) || 0;\n    var 肃 = (g.时钟 && g.时钟.教会肃清进度) || 0;\n    h.push('<div class=\"card\"><h4>时钟</h4>'\n      + '<div class=\"row\"><span class=\"kv\">维尔伦陷落度 <b>' + 陷 + '/6</b></span>'\n      + '<span class=\"clocks\">' + 时钟格(陷, 6, '') + '</span>'\n      + '<span class=\"sub\">' + (阶段名[Math.max(0, Math.min(6, 陷))] || '') + '</span></div>'\n      + '<div class=\"row\"><span class=\"kv\">教会肃清进度 <b>' + 肃 + '/3</b></span>'\n      + '<span class=\"clocks\">' + 时钟格(肃, 3, 's2') + '</span>'\n      + '<span class=\"sub\">' + (肃清名[Math.max(0, Math.min(3, 肃))] || '') + '</span></div>'\n      + '</div>');\n\n    /* 算力 */\n    var 上 = 算力上限(g);\n    var 当 = (g.算力 && g.算力.当前算力) || 0;\n    var 累 = (g.算力 && g.算力.累计消耗) || 0;\n    h.push('<div class=\"card\"><h4>算力</h4>'\n      + '<div class=\"row\"><span class=\"kv\">当前 <b>' + 当 + '</b> / ' + 上\n      + '　速率 ' + esc(g.算力 && g.算力.速率) + '/小时</span></div>'\n      + 进度条(当, 上, '#6ea8fe')\n      + '<div class=\"row\"><span class=\"kv\">累计消耗 <b>' + 累 + '</b>　<span class=\"sub\">异象 100｜裂隙 250</span></span></div>'\n      + 进度条(累, 250, '#b58cf0', [100, 250])\n      + '</div>');\n\n    /* 主角 */\n    var 主 = g.主角 || {};\n    var 装备 = Object.keys(主.装备 || {}).filter(function (k) { return 主.装备[k]; })\n      .map(function (k) { return k + '：' + esc(主.装备[k]); }).join('　') || '无';\n    var 技能 = (主.技能 || []).map(function (s) { return esc(s.名称) + '(' + esc(s.等阶) + ')'; }).join('、') || '无';\n    h.push('<div class=\"card\"><h4>主角</h4>'\n      + '<div class=\"row\">' + 属性名.map(function (n) {\n          return '<span class=\"kv\">' + n + ' <b>' + 属性文本(g, 主, n) + '</b></span>';\n        }).join('') + '</div>'\n      + (主.状态 ? '<div class=\"row\"><span class=\"kv\">状态 <b>' + esc(主.状态) + '</b></span></div>' : '')\n      + '<div class=\"row\"><span class=\"kv\">装备 ' + 装备 + '</span></div>'\n      + '<div class=\"row\"><span class=\"kv\">技能 ' + 技能 + '</span></div>'\n      + '<div class=\"row\"><span class=\"kv\">精练师 ' + esc(主.精练师等级) + '</span>'\n      + '<span class=\"kv\">知识库 ' + esc((主.已解锁知识库 || []).join('、')) + '</span></div>'\n      + '</div>');\n\n    /* 物品 */\n    var 物品 = g.物品 || [];\n    function 组(类型) {\n      var l = 物品.filter(function (i) { return i.类型 === 类型; });\n      if (!l.length) return '<span class=\"muted\">（无）</span>';\n      return l.map(function (i) {\n        return '<span class=\"tag\">' + esc(i.名称) + '×' + i.数量\n          + (i.槽 ? '[' + esc(i.槽) + ']' : '')\n          + (i.持有者 && i.持有者 !== '主角' ? '（' + esc(i.持有者) + '）' : '')\n          + (i.描述 ? ' — ' + esc(i.描述) : '') + '</span>';\n      }).join('');\n    }\n    h.push('<div class=\"card\"><h4>物品</h4>'\n      + '<div class=\"row\"><span class=\"kv\">装备</span>' + 组('装备') + '</div>'\n      + '<div class=\"row\"><span class=\"kv\">消耗品</span>' + 组('消耗品') + '</div>'\n      + '<div class=\"row\"><span class=\"kv\">材料</span>' + 组('材料') + '</div>'\n      + '<div class=\"row\"><span class=\"kv\">特殊</span>' + 组('特殊') + '</div>'\n      + '</div>');\n\n    /* 已遇见人物（按立场分组；死亡灰显） */\n    var 已 = [];\n    var 生物 = g.生物 || {};\n    Object.keys(生物).forEach(function (名) { if (生物[名] && 生物[名].已遇见) 已.push([名, 生物[名]]); });\n    var 同伴 = 已.filter(function (x) { return x[1].立场 === '同伴'; });\n    var 敌对 = 已.filter(function (x) { return x[1].立场 !== '同伴'; });\n    function 卡(x) {\n      var 名 = x[0], b = x[1];\n      var 死 = b.状态 === '死亡';\n      var 临时 = (b.临时加成 || []).length\n        ? '　临时：' + b.临时加成.map(function (t) { return 属性名.indexOf(t.属性) >= 0 ? (t.属性 + (t.值 > 0 ? '+' : '') + t.值) : ''; }).join('、')\n        : '';\n      var 技能 = (b.技能 || []).length\n        ? '<div class=\"sub\">技能：' + b.技能.map(function (s) { return esc(s.名称) + '(' + esc(s.等阶) + ')'; }).join('、') + '</div>' : '';\n      return '<div class=\"unit' + (死 ? ' dead' : '') + '\">'\n        + '<div class=\"nm\">' + esc(名) + ' <span class=\"sub\">' + esc(b.立场) + (死 ? ' · 已死亡' : '') + '</span></div>'\n        + '<div class=\"sub\">力' + 属性文本(g, b, '力量') + ' 敏' + 属性文本(g, b, '敏捷')\n        + ' 体' + 属性文本(g, b, '体质') + ' 智' + 属性文本(g, b, '智力') + 临时 + '</div>'\n        + (b.状态 && !死 ? '<div class=\"sub\">状态：' + esc(b.状态) + '</div>' : '')\n        + 技能 + '</div>';\n    }\n    h.push('<div class=\"card\"><h4>已遇见</h4>'\n      + (已.length === 0 ? '<span class=\"muted\">（尚未遇见任何人）</span>' : '')\n      + (同伴.length ? '<div class=\"sub\" style=\"margin:2px 0 4px\">同伴</div><div class=\"grid2\">' + 同伴.map(卡).join('') + '</div>' : '')\n      + (敌对.length ? '<div class=\"sub\" style=\"margin:6px 0 4px\">敌对</div><div class=\"grid2\">' + 敌对.map(卡).join('') + '</div>' : '')\n      + '</div>');\n\n    return h.join('');\n  }\n\n  /* ── 挂载 ── */\n  function main() {\n    var el = document.getElementById('aiselan-bar');\n    if (!el) return;\n    var g = readSnapshot() || readChat();\n    if (!g) { el.innerHTML = '（艾瑟兰状态栏：未读取到存档，先在扩展「战役」页初始化开局）'; return; }\n    el.innerHTML = 渲染(g);\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', main);\n  } else {\n    main();\n  }\n  /* 楼内重复渲染兜底（换页/编辑后） */\n  window.addEventListener('pageshow', main);\n})();\n</script>\n</body>\n</html>\n",
    "trimStrings": [],
    "placement": [
      2
    ],
    "disabled": false,
    "markdownOnly": true,
    "promptOnly": false,
    "runOnEdit": true,
    "substituteRegex": 0,
    "minDepth": 0,
    "maxDepth": 0
  }
]
